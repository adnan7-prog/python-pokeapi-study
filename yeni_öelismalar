# ekle. Bu proje OOP'nin dört temel prensibini tek bir sistemde uygulatır.
liste=[]
class Kitap:
    def __init__(self,kişiad,kişi_yas):
        self.kişi_ad=kişiad
        self.alacigin = "Henüz kitap alınmadı"
        self.silinen = "Henüz iade edilmedi"
        self._kişi_yas=kişi_yas
        self.__kitapAdi="booykor","lezet","erken","deve kucu"
    def alma(self):
        print("-----kitapalma-------")
        alacigin=input(f"almak istediğiniz kiabin adini yaziniz {[self.__kitapAdi]}:")
        if alacigin in self.__kitapAdi:
            print("başarıyla alındı.")
            self.alacigin=alacigin
            liste.append(alacigin)
        else:
            print("boyle bir kitap yok.")
    def iade_etme(self):
        print("-----iade etme-------")
        iade=input(f"iade etmek istediğiniz kiabin adini yaziniz :")
        if iade in liste:
            print("başarıyla iade edildi.")
            self.silinen=iade
            liste.remove(iade)
        else:
            print("boyle bir kitap yok.")
    def gecikme_kontrolu(self,sure):
        print("---------------gecikme kontrolu------------------")
        suren=int(input("kac aydir gecikme var:"))
        if sure>suren:
            print("gecikme yok.")
        else:
            gecikensure = suren - sure
            
            print(f"gecikmişsiniz , {gecikensure} aydan sure tamamlanmıştır.")
    def hersegi_goster(self):
        dic={
            "ad":self.kişi_ad,
            "yas":self._kişi_yas,
            "aldign_kitap":self.alacigin,
            "silinen":self.silinen
        }
        liste.append(dic)
        print(liste)
uyelistesi=[]
class Uye(Kitap):
    def __init__(self,kişiad,kişi_yas):
        super().__init__(kişiad,kişi_yas)
        self.uye_ol=False
        self.uyesilme=False
        self.name=""
    def uyeol(self):
        print("-----uye ol------")
        ad=input("adınız: ")
        soyad=input("soyadınız: ")
        yas=int(input("yasinız: "))
        hepsi=(ad,soyad,yas)
        self.name=ad
        print(f"uye olma isteyen {hepsi} yasında")
        self.uye_ol="uye eklemek"
        dic={
            "ad":ad,
            "soyad":soyad,
            "yas":yas}
        uyelistesi.append(dic)
        print(uyelistesi)
        print("işlem tamamlandi\n")
    def uyesil(self):
        print("-----uye sil------")
        silinecek_uye = input("silinecek uye: ")
        if silinecek_uye == self.name:
            
            for uye_dic in uyelistesi:
                if isinstance(uye_dic, dict) and uye_dic.get("ad") == silinecek_uye:
                    uyelistesi.remove(uye_dic)
                    print("uye silindi")
                    self.uyesilme = "uye silindi"
                    return
        else:
            print("oyle biri uye bulumadik.")  
    def hersegi_goster(self):
        dic={
            "uye ekleme":self.uye_ol,
            "uye silme":self.uyesilme
            }
        print(uyelistesi.append(dic))
    
